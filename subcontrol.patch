+/// @file   AP_Motors_ControlAlloc.h
+/// @brief  通用控制分配矩阵 (替代硬编码推进器映射)
+///         General Control Allocation Matrix (replaces hardcoded thruster mapping)
+///
+/// 本模块提供基于 Moore-Penrose 伪逆的任意推进器布局控制分配。
+/// 对标 Python 版 control_allocation.py 的核心功能。
+///
+/// 使用方法:
+///   1. 通过 QGC 参数 MOT_n_* 配置每个推进器的位置/方向/推力
+///   2. ControlAllocationMatrix 自动构建 6xN 矩阵 B 并计算伪逆 B+
+///   3. 控制循环中调用 allocate(tau, u_out) 获得各推进器推力
+
+#pragma once
+
+#include <AP_Common/AP_Common.h>
+#include <AP_Math/AP_Math.h>
+
+#define CA_MAX_THRUSTERS    16      // 最大推进器数量
+#define CA_DOF              6       // 自由度 (固定为6)
+#define CA_REG_LAMBDA       1e-6f   // Tikhonov 正则化参数
+
+// ---- 推进器配置 (对应 Python ThrusterConfig) ----
+struct ThrusterConfig {
+    char    name[32];
+    Vector3f position;      // 安装位置 (m, NED)
+    Vector3f direction;     // 推力方向 (自动归一化)
+    float   max_force;      // 正向最大推力 (N)
+    float   min_force;      // 反向最大推力 (N)
+    int8_t  reverse;        // 反向标志
+    char    group[16];
+    float   thrust_curve;   // 正向推力曲线指数 γ (默认2.0=√补偿)
+    float   reverse_curve;  // 反向推力曲线指数 γ (默认2.0)
+};
+
+// ---- 诊断信息 (对应 Python ca_diagnosis_t) ----
+struct ControlAllocDiagnosis {
+    int     rank;
+    float   condition_number;
+    float   singular_values[CA_DOF];
+    int     is_singular;
+    float   frob_norm_B;
+    float   frob_norm_B_pinv;
+    int     n_saturated;
+    float   allocation_error_norm;
+    int     quality_score;          // 0-100
+};
+
+// ---- 控制分配矩阵主类 (对应 Python ControlAllocationMatrix) ----
+class ControlAllocationMatrix {
+public:
+    ControlAllocationMatrix();
+
+    // 初始化: 传入推进器配置数组和重心位置
+    void init(const ThrusterConfig *thrusters, uint8_t n, const Vector3f &cg);
+
+    // 核心: 将 tau 分配到各推进器
+    // method: 0 = 伪逆+等比缩放, 1 = 再分配伪逆(RPI)
+    void allocate(const float tau[CA_DOF], float u_out[], uint8_t method = 0);
+
+    // 便捷: 按独立自由度分配
+    void allocate_dof(float surge, float sway, float heave,
+                      float roll, float pitch, float yaw,
+                      float u_out[]);
+
+    // 诊断
+    void diagnose(ControlAllocDiagnosis &result);
+
+    // 获取分配矩阵信息 (用于调试)
+    void get_matrix_info(char *buf, uint16_t buf_len);
+
+    // 更新推进器配置 (运行时)
+    void update_thrusters(const ThrusterConfig *thrusters, uint8_t n);
+
+    // 获取上次分配结果
+    const float* get_last_output() const { return _last_output; }
+    uint8_t get_num_thrusters() const { return _n_thrusters; }
+
+private:
+    uint8_t _n_thrusters;
+    Vector3f _cg;
+    ThrusterConfig _thrusters[CA_MAX_THRUSTERS];
+
+    // 控制分配矩阵 B (6xN) 及其伪逆 B+ (Nx6)
+    float _B[CA_DOF][CA_MAX_THRUSTERS];
+    float _B_pinv[CA_MAX_THRUSTERS][CA_DOF];
+
+    // 上次分配结果
+    float _last_output[CA_MAX_THRUSTERS];
+    float _last_tau[CA_DOF];
+    uint8_t _last_method;
+
+    bool _initialized;
+
+    // ---- 内部方法 ----
+    void build_B_matrix();
+    float compute_pinv();
+    void allocate_pinv(const float tau[CA_DOF], float u_out[]);
+    void allocate_rpi(const float tau[CA_DOF], float u_out[], uint8_t max_iter = 20);
+
+    // ---- 矩阵运算 ----
+    static void mat_mul_6xN_Nx6(const float A[CA_DOF][CA_MAX_THRUSTERS],
+                                const float B[CA_MAX_THRUSTERS][CA_DOF],
+                                float C[CA_DOF][CA_DOF], int N);
+    static void mat_mul_Nx6_6x1(const float A[CA_MAX_THRUSTERS][CA_DOF],
+                                const float b[CA_DOF],
+                                float c[], int N);
+    static void mat_transpose_6xN(const float A[CA_DOF][CA_MAX_THRUSTERS],
+                                  float AT[CA_MAX_THRUSTERS][CA_DOF], int N);
+    static int  mat_inv_6x6_cholesky(const float A[CA_DOF][CA_DOF],
+                                     float A_inv[CA_DOF][CA_DOF]);
+
+    // ---- 饱和处理 ----
+    void handle_saturation(float u[], uint8_t n);
+};
