+// ★ Subcontrol: 自定义控制分配输出
+// 使用通用的 Moore-Penrose 伪逆矩阵进行推力分配
+void AP_Motors6DOF::output_armed_stabilizing_custom()
+{
+    uint8_t n = _ca_matrix.get_num_thrusters();
+    if (n == 0) return;
+
+    // 从飞行控制器获取 6-DOF 期望力/力矩 (归一化到 -1..1)
+    // 映射到物理力/力矩: 乘以最大推力/力矩
+    float roll_thrust    = (_roll_in + _roll_in_ff);
+    float pitch_thrust   = (_pitch_in + _pitch_in_ff);
+    float yaw_thrust     = (_yaw_in + _yaw_in_ff);
+    float throttle_thrust = get_throttle_bidirectional();
+    float forward_thrust  = _forward_in;
+    float lateral_thrust  = _lateral_in;
+
+    // 限制油门范围
+    if (throttle_thrust <= -_throttle_thrust_max) {
+        throttle_thrust = -_throttle_thrust_max;
+        limit.throttle_lower = true;
+    }
+    if (throttle_thrust >= _throttle_thrust_max) {
+        throttle_thrust = _throttle_thrust_max;
+        limit.throttle_upper = true;
+    }
+
+    // 将归一化控制输入映射为 6-DOF 力/力矩向量 tau
+    // tau = [Fx, Fy, Fz, Mx, My, Mz]  (NED, N / N·m)
+    // 注意: 此处使用各推进器总能力的 1/2 作为最大期望值
+    const float max_force_per_axis  = 200.0f;   // 单轴最大推力 (N)
+    const float max_torque_per_axis = 50.0f;    // 单轴最大力矩 (N·m)
+
+    float tau[6];
+    tau[0] = forward_thrust  * max_force_per_axis;   // Fx (Surge)
+    tau[1] = lateral_thrust  * max_force_per_axis;   // Fy (Sway)
+    tau[2] = throttle_thrust * max_force_per_axis;   // Fz (Heave)
+    tau[3] = roll_thrust     * max_torque_per_axis;  // Mx (Roll)
+    tau[4] = pitch_thrust    * max_torque_per_axis;  // My (Pitch)
+    tau[5] = yaw_thrust      * max_torque_per_axis;  // Mz (Yaw)
+
+    // ★ 核心: 使用通用控制分配矩阵将 tau 分配到各推进器
+    // RPI 方法: 迭代处理饱和, 保持力矩方向
+    float u[CA_MAX_THRUSTERS];
+    _ca_matrix.allocate(tau, u, 1);  // method=1: RPI
+
+    // 将推力(牛顿)转换为油门(-1..1)，并用推力曲线反函数补偿非线性
+    //   throttle = sign(u)·(|u|/F_i_max)^(1/γ)
+    // 之前用固定 norm_factor=100 且纯线性映射，导致:
+    //   1) 与各推进器自身 F_MAX/F_MIN 无关 (布局不同就错乱)
+    //   2) 把非线性"转速→推力"当线性，实际推力 = F_max·油门² 被压软
+    // 现在除以该推进器自身在该方向的极限力，再按可调指数 γ 反解油门。
+    for (uint8_t i = 0; i < n; i++) {
+        // 该方向的最大推力幅值 (FMIN 为负值，取幅值)
+        float f_i = (u[i] >= 0.0f) ? _thr_fmax[i] : -_thr_fmin[i];
+        // 每桨推力曲线指数 (按型号标定); ≤0 则退回全局参数，再退 2.0
+        float gamma = (u[i] >= 0.0f) ? _thr_curve[i] : _thr_rev_curve[i];
+        if (gamma <= 0.0f) {
+            gamma = (u[i] >= 0.0f) ? _ca_thrust_curve : _ca_reverse_curve;
+        }
+        if (gamma <= 0.0f) {
+            gamma = 2.0f;
+        }
+
+        if (f_i <= 0.0f || gamma <= 0.0f || u[i] == 0.0f) {
+            _thrust_rpyt_out[i] = 0.0f;
+        } else {
+            float ratio = constrain_float(fabsf(u[i]) / f_i, 0.0f, 1.0f);
+            float throttle = powf(ratio, 1.0f / gamma);
+            _thrust_rpyt_out[i] = (u[i] > 0.0f) ? throttle : -throttle;
+        }
+    }
+
+    // 未使用的电机置零
+    for (uint8_t i = n; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        _thrust_rpyt_out[i] = 0.0f;
+    }
+
+    // 电流限制 (与原版相同)
+#if AP_BATTERY_ENABLED
+    const AP_BattMonitor &battery = AP::battery();
+    float _batt_current;
+    if (_batt_current_max > 0.0f && battery.current_amps(_batt_current)) {
+        float _batt_current_delta = _batt_current - _batt_current_last;
+        float _current_change_rate = _batt_current_delta / _dt_s;
+        float predicted_current = _batt_current + (_current_change_rate * _dt_s * 5);
+        float batt_current_ratio = _batt_current / _batt_current_max;
+        if (predicted_current > _batt_current_max * 1.5f) {
+            batt_current_ratio = 2.5f;
+        } else if (_batt_current < _batt_current_max && predicted_current > _batt_current_max) {
+            batt_current_ratio = predicted_current / _batt_current_max;
+        }
+        _batt_current_last = _batt_current;
+        _output_limited += (_dt_s / (_dt_s + _batt_current_time_constant)) * (1 - batt_current_ratio);
+    }
+#endif
+    _output_limited = constrain_float(_output_limited, 0.0f, 1.0f);
+
+    for (uint8_t i = 0; i < AP_MOTORS_MAX_NUM_MOTORS; i++) {
+        if (motor_enabled[i]) {
+            _thrust_rpyt_out[i] *= _output_limited;
+        }
+    }
+}
